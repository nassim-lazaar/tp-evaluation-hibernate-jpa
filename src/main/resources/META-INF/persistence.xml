<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence
             http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd"
             version="2.2">
    <persistence-unit name="evaluationPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Exercice 1 : Stock -->
        <class>ma.projet.classes.stock.Categorie</class>
        <class>ma.projet.classes.stock.Produit</class>
        <class>ma.projet.classes.stock.Commande</class>
        <class>ma.projet.classes.stock.LigneCommandeProduit</class>

        <!-- Exercice 2 : Projet -->
        <class>ma.projet.classes.projet.Employe</class>
        <class>ma.projet.classes.projet.Projet</class>
        <class>ma.projet.classes.projet.Tache</class>
        <class>ma.projet.classes.projet.EmployeTache</class>

        <!-- Exercice 3 : Etat Civil -->
        <class>ma.projet.classes.etatcivil.Personne</class>
        <class>ma.projet.classes.etatcivil.Homme</class>
        <class>ma.projet.classes.etatcivil.Femme</class>
        <class>ma.projet.classes.etatcivil.Mariage</class>

        <properties>
            <property name="javax.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="javax.persistence.jdbc.url" value="jdbc:h2:mem:evaluation_db;DB_CLOSE_DELAY=-1"/>
            <property name="javax.persistence.jdbc.user" value="sa"/>
            <property name="javax.persistence.jdbc.password" value=""/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
